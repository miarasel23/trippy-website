# Production Environment Configuration
# This file is loaded automatically when running `next build` and `next start`
# Unlike .env.local, this file IS deployed to the production server

# Backend API Configuration
# The production server (100.48.152.111) reaches the backend via this domain
NEXT_PUBLIC_API_BASE_URL=https://apitrippy.online
NEXT_PUBLIC_SOCKET_URL=https://apitrippy.online
NEXT_PUBLIC_SOCKET_PATH=/socket.io

# Server-side only: fallback for server-to-server calls (not exposed to browser)
# Uses the direct IP internally for faster server-side API calls
BACKEND_API_BASE_URL=https://apitrippy.online

